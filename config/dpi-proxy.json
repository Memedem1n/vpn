{
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "doh",
        "server": "1.1.1.1"
      },
      {
        "type": "https",
        "tag": "doh2",
        "server": "9.9.9.9"
      }
    ],
    "final": "doh",
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 2080
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "protocol": "quic",
        "action": "reject"
      },
      {
        "protocol": "tls",
        "action": "route-options",
        "tls_fragment": true
      }
    ],
    "final": "direct",
    "auto_detect_interface": true,
    "default_domain_resolver": "doh"
  }
}
